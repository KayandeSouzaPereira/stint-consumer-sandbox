<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.stintflow.sandbox</groupId>
        <artifactId>stint-consumer-sandbox-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <!-- SDD S.1: the Orders domain (port 8081), with its own engine over Stint's AWS connectors. -->
    <artifactId>sandbox-orders</artifactId>

    <dependencies>
        <!-- Stint: core + AWS connectors + JSON logging (bundle), YAML contracts, worker runtime, tracing -->
        <dependency>
            <groupId>io.github.stintflow</groupId>
            <artifactId>stint-bundle-aws</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.stintflow</groupId>
            <artifactId>stint-dsl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.stintflow</groupId>
            <artifactId>stint-worker-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.stintflow</groupId>
            <artifactId>stint-otel</artifactId>
        </dependency>

        <!-- Quarkus wiring -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-opentelemetry</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
            <!-- SDD S.1, RF7: Orders never depends on Billing, nor on Stint's in-memory connectors at runtime.
                 The two domains share only contracts/events.md. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>sovereign-domain</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>io.stintflow.sandbox:sandbox-billing</exclude>
                                        <exclude>io.github.stintflow:stint-inmemory:*:*:compile</exclude>
                                        <exclude>io.github.stintflow:stint-inmemory:*:*:runtime</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
