{
  "version": 1,
  "description": "SDD S.5, 8b: per type, who publishes it, its data schema, and the CloudEvents attributes and extensions it must carry. Correlation is by these extensions and subject, never by data (Stint 3a.5).",
  "extensions": {
    "sandboxproject": "^[a-z0-9-]{1,40}$",
    "sandboxcycle": "^[1-9][0-9]{0,3}$",
    "sandboxsdd": "^[A-Za-z0-9._:-]{1,128}$",
    "sandboxstage": "^(business|technical)$",
    "sandboxdomain": "^(business|engineering|delivery)$"
  },
  "types": {
    "io.sandbox.channels.meeting-recorded.v1": {
      "source": "https://sandbox.stintflow.io/channels",
      "schema": "meeting-recorded.v1.schema.json",
      "extensions": [
        "sandboxproject",
        "sandboxcycle",
        "sandboxstage"
      ]
    },
