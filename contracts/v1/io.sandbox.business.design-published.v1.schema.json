{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandbox.stintflow.io/contracts/v1/io.sandbox.business.design-published.v1.schema.json",
  "title": "io.sandbox.business.design-published.v1 — data (SDD S.5, 8b)",
  "description": "The business representative approved a design document; Engineering starts refining it. Ids, pointers, enums and counts only: never any text of a meeting, document or person. Additive changes only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documentId",
    "recordId",
    "version",
    "designRef",
    "channel"
  ],
  "properties": {
    "documentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "recordId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "designRef": {
      "type": "string",
      "pattern": "^(s3|record)://[A-Za-z0-9._/:-]{1,512}$",
      "description": "A pointer: s3://bucket/key or record://<recordId>/<version>"
    },
    "channel": {
      "enum": [
        "email",
        "confluence",
        "meeting"
      ]
    }
  }
}
