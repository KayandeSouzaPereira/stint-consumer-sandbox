{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandbox.stintflow.io/contracts/v1/io.sandbox.engineering.questions-sent.v1.schema.json",
  "title": "io.sandbox.engineering.questions-sent.v1 — data (SDD S.5, 8b)",
  "description": "Engineering has a blocking question: the questions go to Business by e-mail and the cycle restarts with nextCycle. Ids, pointers, enums and counts only: never any text of a meeting, document or person. Additive changes only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordId",
    "questionsRef",
    "questionCount",
    "nextCycle"
  ],
  "properties": {
    "recordId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "questionsRef": {
      "type": "string",
      "pattern": "^(s3|record)://[A-Za-z0-9._/:-]{1,512}$",
      "description": "A pointer: s3://bucket/key or record://<recordId>/<version>"
    },
    "questionCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "nextCycle": {
      "type": "integer",
      "minimum": 2
    }
  }
}
