{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandbox.stintflow.io/contracts/v1/io.sandbox.engineering.sdd-batch-approved.v1.schema.json",
  "title": "io.sandbox.engineering.sdd-batch-approved.v1 — data (SDD S.5, 8b)",
  "description": "The technical representative approved a batch of SDDs; Delivery implements them, one instance per SDD (8a, A). Ids, pointers, enums and counts only: never any text of a meeting, document or person. Additive changes only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batchId",
    "batchRef",
    "sddIds",
    "recordIds"
  ],
  "properties": {
    "batchId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "batchRef": {
      "type": "string",
      "pattern": "^(s3|record)://[A-Za-z0-9._/:-]{1,512}$",
      "description": "A pointer: s3://bucket/key or record://<recordId>/<version>"
    },
    "sddIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{1,128}$"
      }
    },
    "priority": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "recordIds": {
      "type": "array",
      "maxItems": 21,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{1,128}$"
      }
    }
  }
}
