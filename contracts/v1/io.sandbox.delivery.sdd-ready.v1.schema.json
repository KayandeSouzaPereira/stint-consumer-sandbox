{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandbox.stintflow.io/contracts/v1/io.sandbox.delivery.sdd-ready.v1.schema.json",
  "title": "io.sandbox.delivery.sdd-ready.v1 — data (SDD S.5, 8b)",
  "description": "The cycle's coordinator hands one SDD to its own delivery instance. Ids, pointers, enums and counts only: never any text of a meeting, document or person. Additive changes only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sddId",
    "recordId",
    "sddRef",
    "designRecordId",
    "techRecordId"
  ],
  "properties": {
    "sddId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "recordId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "sddRef": {
      "type": "string",
      "pattern": "^(s3|record)://[A-Za-z0-9._/:-]{1,512}$",
      "description": "A pointer: s3://bucket/key or record://<recordId>/<version>"
    },
    "designRecordId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "techRecordId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    }
  }
}
